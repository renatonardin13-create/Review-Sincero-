{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and auth status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "productNotification": {
      "title": "Product Notification",
      "description": "Affiliate product notification banner",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "url": { "type": "string", "maxLength": 500 },
        "ctaText": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["name", "imageUrl", "url", "active", "order"]
    },
    "systemUpdate": {
      "title": "System Update",
      "description": "Platform announcement or update",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "ctaText": { "type": "string", "maxLength": 50 },
        "ctaUrl": { "type": "string", "maxLength": 500 },
        "version": { "type": "string", "maxLength": 30 },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "publishedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["title", "message", "version", "published"]
    },
    "notificationRead": {
      "title": "Notification Read",
      "description": "Read status record per user for system updates",
      "type": "object",
      "properties": {
        "readAt": { "type": "string" }
      },
      "required": ["readAt"]
    },
    "globalSettings": {
      "title": "Global Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "productNotificationIntervalMinutes": { "type": "number" },
        "siteName": { "type": "string" },
        "authorName": { "type": "string" },
        "defaultTemplate": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "academyModule": {
      "title": "Academy Module",
      "description": "Module container for academy course lessons",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["title", "order", "status"]
    },
    "academyLesson": {
      "title": "Academy Lesson",
      "description": "Individual video lesson in a module",
      "type": "object",
      "properties": {
        "moduleId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "videoUrl": { "type": "string", "maxLength": 500 },
        "thumbnailUrl": { "type": "string", "maxLength": 500 },
        "duration": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["published", "draft"] },
        "publishedAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["moduleId", "title", "videoUrl", "order", "status"]
    },
    "systemNotification": {
      "title": "System Notification",
      "description": "Notification for lessons, modules or updates",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["lesson", "module", "update", "general"] },
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "targetView": { "type": "string", "maxLength": 100 },
        "targetId": { "type": "string", "maxLength": 128 },
        "ctaText": { "type": "string", "maxLength": 60 },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["type", "title", "message", "published"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User account and permission profiles"
    },
    "/product_notifications/{notificationId}": {
      "schema": "productNotification",
      "description": "Floating product notifications"
    },
    "/system_updates/{updateId}": {
      "schema": "systemUpdate",
      "description": "System updates and announcements"
    },
    "/users/{userId}/notificationReads/{updateId}": {
      "schema": "notificationRead",
      "description": "Read status for system updates by user"
    },
    "/global_settings/{settingId}": {
      "schema": "globalSettings",
      "description": "Global configuration settings"
    },
    "/academy_modules/{moduleId}": {
      "schema": "academyModule",
      "description": "Academy course modules"
    },
    "/academy_lessons/{lessonId}": {
      "schema": "academyLesson",
      "description": "Academy course lessons"
    },
    "/system_notifications/{notificationId}": {
      "schema": "systemNotification",
      "description": "Automated system notifications for users"
    }
  }
}
