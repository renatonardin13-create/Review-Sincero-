{
  "entities": {
    "user": {
      "title": "User",
      "description": "User profile and auth status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["active", "blocked"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email", "role", "status"]
    },
    "productNotification": {
      "title": "Product Notification",
      "description": "Affiliate product notification banner",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 150 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "url": { "type": "string", "maxLength": 500 },
        "ctaText": { "type": "string", "maxLength": 50 },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["name", "imageUrl", "url", "active", "order"]
    },
    "systemUpdate": {
      "title": "System Update",
      "description": "Platform announcement or update",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "ctaText": { "type": "string", "maxLength": 50 },
        "ctaUrl": { "type": "string", "maxLength": 500 },
        "version": { "type": "string", "maxLength": 30 },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "publishedAt": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 256 }
      },
      "required": ["title", "message", "version", "published"]
    },
    "notificationRead": {
      "title": "Notification Read",
      "description": "Read status record per user for system updates",
      "type": "object",
      "properties": {
        "readAt": { "type": "string" }
      },
      "required": ["readAt"]
    },
    "globalSettings": {
      "title": "Global Settings",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "productNotificationIntervalMinutes": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User account and permission profiles"
    },
    "/product_notifications/{notificationId}": {
      "schema": "productNotification",
      "description": "Floating product notifications"
    },
    "/system_updates/{updateId}": {
      "schema": "systemUpdate",
      "description": "System updates and announcements"
    },
    "/users/{userId}/notificationReads/{updateId}": {
      "schema": "notificationRead",
      "description": "Read status for system updates by user"
    },
    "/global_settings/{settingId}": {
      "schema": "globalSettings",
      "description": "Global configuration settings"
    }
  }
}
