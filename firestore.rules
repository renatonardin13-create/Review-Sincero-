rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'renatonardin13@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email.lower() == 'renatonardin13@gmail.com' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked')
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    // Presence Tracking: public can read/write to manage sessions
    match /presence/{sessionId} {
      allow read, write: if true;
    }

    // User profiles: strictly restricted to the owner or admin
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      match /notificationReads/{updateId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Product Notifications: public can read, only admin can write
    match /product_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Updates: public can read, only admin can write
    match /system_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Notifications (automated alerts for new lessons, modules, updates): public can read, only admin can write
    match /system_notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global Settings: public can read, only admin can write
    match /global_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sales Quiz collections
    match /quiz_questions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quiz_results/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quiz_products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /quiz_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sales Funnel collections
    match /sales_funnels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /sales_funnel_steps/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Academy Lessons: public can read, only admin can write
    match /academy_lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Academy Modules: public can read, only admin can write
    match /academy_modules/{moduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
