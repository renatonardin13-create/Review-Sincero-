rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'renatonardin13@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'renatonardin13@gmail.com') &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked')
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create: if isSignedIn() && isOwner(userId) && 
        (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == 'user') &&
        (!request.resource.data.keys().hasAll(['status']) || request.resource.data.status == 'active');
      allow update: if isSignedIn() && (
        isAdmin() || 
        (isOwner(userId) && 
         (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']))
        )
      );
    }

    match /product_notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    match /system_updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId}/notificationReads/{updateId} {
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());
      allow create, update: if isSignedIn() && isOwner(userId) && isValidId(updateId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    match /global_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /academy_lessons/{lessonId} {
      allow read: if isSignedIn() && (resource.data.published == true || resource.data.published == null || isAdmin());
      allow write: if isAdmin();
    }

    match /academy_modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
