rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'renatonardin13@gmail.com';
    }

    match /global_settings/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /product_notifications/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{document} {
      allow read, write: if true;
    }
  }
}
