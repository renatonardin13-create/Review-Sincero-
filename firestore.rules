rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'renatonardin13@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == 'renatonardin13@gmail.com') &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'blocked')
      );
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /product_notifications/{notificationId} {
      allow read, write: if true;
    }

    match /system_updates/{updateId} {
      allow read, write: if true;
    }

    match /users/{userId}/notificationReads/{updateId} {
      allow read, write: if true;
    }

    match /global_settings/{settingId} {
      allow read, write: if true;
    }

    match /academy_lessons/{lessonId} {
      allow read: if true;
      allow write: if true;
    }

    match /academy_modules/{moduleId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
